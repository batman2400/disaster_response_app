{
  "expo": {
    "name": "Fender",
    "slug": "disaster-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "disastermobile",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Used to tag your hazard report with GPS.",
        "NSCameraUsageDescription": "Used to photograph the hazard or the completed repair.",
        "NSPhotoLibraryUsageDescription": "Used to attach a hazard photo."
      }
    },
    "android": {
      "package": "com.uvaram2004.disastermobile",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Used to tag your hazard report with GPS."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Used to attach a hazard photo.",
          "cameraPermission": "Used to photograph the hazard or the completed repair."
        }
      ],
      "react-native-maps"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c3095ff7-b9b3-4a48-ace9-bfaacf21ac6f"
      }
    },
    "owner": "uvaram2004"
  }
}
