{
  "expo": {
    "name": "Colombo Response",
    "slug": "disaster-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "disastermobile",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Used to tag your hazard report with GPS.",
        "NSCameraUsageDescription": "Used to photograph the hazard or the completed repair.",
        "NSPhotoLibraryUsageDescription": "Used to attach a hazard photo."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07111C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#07111C"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Used to tag your hazard report with GPS."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Used to attach a hazard photo.",
          "cameraPermission": "Used to photograph the hazard or the completed repair."
        }
      ],
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "YOUR_ANDROID_MAPS_KEY"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
